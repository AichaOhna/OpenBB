        "            return {'GA': 0, 'GTA': 0, 'PAIE': 0, 'PORTAIL': 0}\n",
        "\n",
        "        def safe_strip(value):\n",
        "            if pd.isna(value) or not isinstance(value, str):\n",
        "                return ''\n",
        "            return value.strip().lower()\n",
        "\n",
        "        def parse_logged_time(time_str):\n",
        "            if pd.isna(time_str):\n",
        "                print(f\"⚠️ Valeur LoggedTime nulle pour {time_str}\")\n",
        "                return 0.0\n",
        "            if isinstance(time_str, (int, float)):\n",
        "                return float(time_str) / 8\n",
        "            time_str = str(time_str).strip().lower()\n",
        "            try:\n",
        "                if 'h' in time_str:\n",
        "                    hours = float(re.sub(r'[^0-9.]', '', time_str.split('h')[0]))\n",
        "                    if 'm' in time_str:\n",
        "                        minutes = float(re.sub(r'[^0-9.]', '', time_str.split('m')[0].split('h')[-1])) / 60\n",
        "                        return (hours + minutes) / 8\n",
        "                    return hours / 8\n",
        "                return float(time_str) / 8 if time_str.replace('.', '').isdigit() else 0.0\n",
        "            except (ValueError, AttributeError):\n",
        "                print(f\"⚠️ Erreur de conversion pour {time_str}, valeur mise à 0\")\n",
        "                return 0.0\n",
        "\n",
        "        # Filtrer par projet\n",
        "        df_filtered = df_timesheet[df_timesheet[client_col].apply(lambda x: safe_strip(x) == project_name.lower())].copy()\n",
        "        print(f\"📊 Valeurs uniques dans '{client_col}' (normalisées): {df_timesheet[client_col].apply(safe_strip).dropna().unique()}\")\n",
        "        print(f\"📊 Valeurs uniques dans '{client_col}' (brutes): {df_timesheet[client_col].dropna().unique()}\")\n",
        "        if df_filtered.empty:\n",
        "            print(f\"❌ Aucun enregistrement trouvé pour le projet '{project_name}' (valeurs uniques dans '{client_col}': {df_timesheet[client_col].dropna().unique()})\")\n",
        "            return {'GA': 0, 'GTA': 0, 'PAIE': 0, 'PORTAIL': 0}\n",
        "\n",
        "        print(f\"✅ {len(df_filtered)} enregistrements filtrés pour le projet '{project_name}'\")\n",
        "        df_filtered['LoggedTime_Days'] = df_filtered[logged_time_col].apply(parse_logged_time)\n",
        "        print(f\"📊 Valeurs uniques dans '{domaine_col}' (brutes): {df_filtered[domaine_col].dropna().unique()}\")\n",
        "\n",
        "        # Mappage amélioré avec formes exactes, renvoyant en majuscules\n",
        "        module_mapping = {\n",
        "            'ga': 'GA', 'gta': 'GTA', 'paie': 'PAIE', 'portail': 'PORTAIL',\n",
        "            'ga ': 'GA', 'gta ': 'GTA', 'paie ': 'PAIE', 'portail ': 'PORTAIL',\n",
        "            'paie': 'PAIE', 'paie ': 'PAIE', 'PAIE': 'PAIE', 'Paie': 'PAIE',\n",
        "            'portail': 'PORTAIL', 'portail ': 'PORTAIL', 'PORTAIL': 'PORTAIL', 'Portail': 'PORTAIL',\n",
        "            'gta': 'GTA', 'gta ': 'GTA', 'GTA': 'GTA', 'Gta': 'GTA',\n",
        "            'ga': 'GA', 'ga ': 'GA', 'GA': 'GA', 'Ga': 'GA',\n",
        "            'GTA': 'GTA', 'GA': 'GA', 'Paie': 'PAIE', 'Portail': 'PORTAIL'\n",
        "        }\n",
        "\n",
        "        consumed_charges = {'GA': 0, 'GTA': 0, 'PAIE': 0, 'PORTAIL': 0}\n",
        "        for idx, row in df_filtered.iterrows():\n",
        "            domaine_value = row[domaine_col]\n",
        "            domaine_normalized = safe_strip(row[domaine_col])\n",
        "            logged_time_value = row[logged_time_col]\n",
        "            print(f\"  🔍 Ligne {idx}: domaine brut='{domaine_value}', normalisé='{domaine_normalized}', logged_time_brut='{logged_time_value}'\")\n",
        "            if domaine_value in module_mapping or domaine_normalized in module_mapping:\n",
        "                module = module_mapping.get(domaine_value, module_mapping.get(domaine_normalized, None))\n",
        "                if module:\n",
        "                    logged_days = row['LoggedTime_Days']\n",
        "                    consumed_charges[module] += logged_days\n",
        "                    print(f\"  ✅ Ligne {idx}: {logged_days}j ajoutés au module {module} (domaine: '{domaine_value}', logged_time: '{logged_time_value}')\")\n",
        "                else:\n",
        "                    print(f\"  ⚠️ Module non mappé pour domaine '{domaine_value}' (normalisé: '{domaine_normalized}')\")\n",
        "            else:\n",
        "                print(f\"  ⚠️ Domaine '{domaine_value}' (normalisé: '{domaine_normalized}') non mappé\")\n",
        "\n",
        "        for module in consumed_charges:\n",
        "            consumed_charges[module] = round(consumed_charges[module], 2)\n",
        "            print(f\"  🎯 Charge consommée pour {module}: {consumed_charges[module]}j\")\n",
        "\n",
        "        return consumed_charges\n",
        "    except Exception as e:\n",
        "        print(f\"❌ Erreur lors du calcul de la charge consommée: {e}\")\n",
        "        return {'GA': 0, 'GTA': 0, 'PAIE': 0, 'PORTAIL': 0}\n",
        "\n",
        "def calculate_consumed_charge_anneaux(jira_file, project_name):\n",
        "    try:\n",
        "        # Tester différents délimiteurs possibles pour le fichier CSV\n",
        "        for delimiter in [',', ';', '\\t']:\n",
