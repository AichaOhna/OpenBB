        "\n",
        "def calculate_consumed_charge(timesheet_file, project_name):\n",
        "    try:\n",
        "        df_timesheet = pd.read_excel(timesheet_file)\n",
        "        print(f\"📊 Shape du fichier timesheet: {df_timesheet.shape}\")\n",
