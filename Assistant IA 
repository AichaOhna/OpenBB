        "\n",
        "        client_col = next((col for col in df_timesheet.columns if 'client' in str(col).lower()), None)\n",
        "        domaine_col = next((col for col in df_timesheet.columns if 'domaine__1 (production)' in str(col).lower()), None)\n",
        "        logged_time_col = next((col for col in df_timesheet.columns if 'loggedtime' in str(col).lower()), None)\n",
        "\n",
