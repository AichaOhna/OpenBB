        "class QualityValidator:\n",
        "    \"\"\"Validateur de qualité des recommandations\"\"\"\n",
        "\n",
        "    def __init__(self, config_manager: ConfigurationManager):\n",
        "        self.config = config_manager.config['validation']\n",
        "\n",
        "    def validate_actions(self, actions: List[str], module: str) -> Tuple[bool, List[str]]:\n",
        "        \"\"\"Valide la qualité des actions générées\"\"\"\n",
        "        errors = []\n",
        "\n",
        "        # Vérifier le nombre d'actions\n",
        "        if len(actions) < self.config['min_actions_per_module']:\n",
        "            errors.append(f\"Nombre d'actions insuffisant: {len(actions)} < {self.config['min_actions_per_module']}\")\n",
        "\n",
        "        if len(actions) > self.config['max_actions_per_module']:\n",
        "            errors.append(f\"Trop d'actions: {len(actions)} > {self.config['max_actions_per_module']}\")\n",
        "\n",
        "        # Vérifier le contenu de chaque action\n",
        "        for i, action in enumerate(actions, 1):\n",
        "            action_errors = self._validate_single_action(action, i)\n",
        "            errors.extend(action_errors)\n",
        "\n",
        "        # Vérifier la diversité des actions\n",
        "        if self._check_action_diversity(actions) < 0.6:\n",
        "            errors.append(\"Actions trop similaires, manque de diversité\")\n",
        "\n",
        "        return len(errors) == 0, errors\n",
        "\n",
        "    def _validate_single_action(self, action: str, index: int) -> List[str]:\n",
        "        \"\"\"Valide une action individuelle\"\"\"\n",
        "        errors = []\n",
        "\n",
        "        # Vérifier la longueur minimale\n",
        "        if len(action) < 50:\n",
        "            errors.append(f\"Action {index} trop courte: {len(action)} caractères\")\n",
        "\n",
        "        # Vérifier la présence de mots-clés obligatoires\n",
        "        required_keywords = ['délai', 'objectif', 'ressources']\n",
        "        missing_keywords = [kw for kw in required_keywords if kw.lower() not in action.lower()]\n",
        "        if missing_keywords:\n",
        "            errors.append(f\"Action {index} manque: {', '.join(missing_keywords)}\")\n",
        "\n",
        "        return errors\n",
        "\n",
        "    def _check_action_diversity(self, actions: List[str]) -> float:\n",
        "        \"\"\"Calcule un score de diversité des actions (0-1)\"\"\"\n",
        "        if len(actions) < 2:\n",
        "            return 1.0\n",
        "\n",
        "        # Analyse basée sur les mots-clés uniques\n",
        "        all_words = []\n",
        "        for action in actions:\n",
        "            words = set(action.lower().split())\n",
        "            all_words.extend(words)\n",
        "\n",
        "        unique_words = len(set(all_words))\n",
        "        total_words = len(all_words)\n",
        "\n",
        "        return unique_words / total_words if total_words > 0 else 0.0\n",
        "\n",
