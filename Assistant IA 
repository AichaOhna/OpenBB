        "                            return formatted_date\n",
        "                    except Exception as e:\n",
        "                        print(f\"⚠️ Erreur lecture date de passation: {e}\")\n",
        "        print(f\"❌ Aucune date de passation valide trouvée pour {module_name}\")\n",
        "        return None\n",
        "    except Exception as e:\n",
        "        print(f\"❌ Erreur lecture fichier: {e}\")\n",
        "        return None\n",
        "\n",
        "def process_monday_parametrage_same_line_dates(input_file_path):\n",
        "    \"\"\"\n",
        "    Version modifiée pour détecter dates sur la même ligne Paramétrage :\n",
        "    1. Cherche UNIQUEMENT les lignes \"Paramétrage\" pour chaque module\n",
        "    2. Prend le statut ET les dates de cette ligne spécifique\n",
        "    3. Si pas de dates sur ligne Paramétrage, cherche dans les sous-tâches de PARAMÉTRAGE\n",
        "    4. Retourne les données sans écrire de fichier\n",
        "    \"\"\"\n",
        "    print(\"=== TRAITEMENT PARAMÉTRAGE - DATES SUR MÊME LIGNE + SOUS-TÂCHES PARAMÉTRAGE ===\")\n",
        "\n",
        "    # Lecture du fichier d'entrée avec pandas\n",
        "    try:\n",
        "        df_test = pd.read_excel(input_file_path)\n",
        "        print(f\"📊 Test lecture - shape: {df_test.shape}\")\n",
        "        print(f\"📊 Premières colonnes: {list(df_test.columns)[:5]}\")\n",
        "        project_name = df_test.columns[0] if not df_test.empty else 'Cassous'\n",
        "\n",
        "        header_row = None\n",
        "        for idx in range(min(10, len(df_test))):\n",
        "            row_values = df_test.iloc[idx].astype(str).values\n",
        "            row_text = ' '.join(row_values).lower()\n",
        "            if 'échéancier - start' in row_text and 'échéancier - end' in row_text:\n",
        "                header_row = idx\n",
        "                print(f\"✅ Ligne d'en-têtes trouvée à l'index: {idx}\")\n",
        "                break\n",
        "\n",
        "        if header_row is not None:\n",
        "            df_input = pd.read_excel(input_file_path, header=header_row)\n",
        "            print(f\"✅ Fichier d'entrée relu avec header={header_row} ({df_input.shape})\")\n",
        "        else:\n",
        "            df_input = df_test.copy()\n",
        "            new_columns = df_input.columns.tolist()\n",
        "            for i, col in enumerate(new_columns):\n",
        "                if i == 7:\n",
        "                    new_columns[i] = 'Échéancier - Start'\n",
        "                elif i == 8:\n",
        "                    new_columns[i] = 'Échéancier - End'\n",
        "                elif i == 18:\n",
        "                    new_columns[i] = 'Date d\\'achèvement'\n",
        "            df_input.columns = new_columns\n",
        "            print(f\"✅ Colonnes remappées manuellement\")\n",
        "        print(f\"\\n📊 Colonnes du fichier final: {list(df_input.columns)}\")\n",
        "    except Exception as e:\n",
        "        print(f\"❌ Erreur lecture input: {e}\")\n",
        "        return None\n",
        "\n",
        "    def is_valid_date(date_obj):\n",
        "        if pd.isna(date_obj):\n",
        "            return False\n",
        "        if not isinstance(date_obj, datetime):\n",
        "            try:\n",
        "                date_obj = pd.to_datetime(date_obj)\n",
        "            except:\n",
        "                return False\n",
        "        if date_obj.year < 2000 or date_obj.year > 2050:\n",
        "            print(f\"    ⚠️ Date rejetée: {date_obj}\")\n",
        "            return False\n",
        "        return True\n",
        "\n",
        "    def format_date_only(date_obj):\n",
        "        if pd.isna(date_obj):\n",
        "            return None\n",
        "        try:\n",
        "            if not isinstance(date_obj, datetime):\n",
        "                date_obj = pd.to_datetime(date_obj)\n",
        "            if not is_valid_date(date_obj):\n",
        "                return None\n",
        "            return date_obj.strftime('%d/%m/%Y')\n",
        "        except Exception as e:\n",
        "            print(f\"    ⚠️ Erreur formatage date: {e}\")\n",
        "            return None\n",
        "\n",
        "    def parse_date_string(date_string):\n",
        "        if not date_string or pd.isna(date_string):\n",
        "            return None\n",
        "        try:\n",
        "            if isinstance(date_string, str):\n",
        "                return datetime.strptime(date_string, '%d/%m/%Y')\n",
        "            elif isinstance(date_string, datetime):\n",
        "                return date_string\n",
        "            else:\n",
        "                return pd.to_datetime(date_string)\n",
        "        except Exception as e:\n",
        "            print(f\"    ⚠️ Erreur parsing date '{date_string}': {e}\")\n",
        "            return None\n",
        "\n",
        "    def calculate_workdays(start_date_str, end_date_str):\n",
        "        print(f\"\\n📊 === CALCUL WORKDAYS ===\")\n",
        "        print(f\"  Date début: {start_date_str}\")\n",
        "        print(f\"  Date fin: {end_date_str}\")\n",
        "        if not start_date_str or not end_date_str:\n",
        "            print(f\"  ❌ Dates manquantes\")\n",
        "            return None\n",
        "        start_date = parse_date_string(start_date_str)\n",
        "        end_date = parse_date_string(end_date_str)\n",
        "        if not start_date or not end_date:\n",
        "            print(f\"  ❌ Erreur conversion dates\")\n",
        "            return None\n",
        "        if start_date > end_date:\n",
        "            print(f\"  ⚠️ Date début postérieure à date fin, inversion...\")\n",
        "            start_date, end_date = end_date, start_date\n",
        "        print(f\"  📅 Dates converties: {start_date.strftime('%d/%m/%Y')} -> {end_date.strftime('%d/%m/%Y')}\")\n",
        "        try:\n",
        "            years = list(range(start_date.year, end_date.year + 1))\n",
        "            morocco_holidays = holidays.Morocco(years=years)\n",
        "            print(f\"  🎉 Jours fériés Maroc chargés pour {years}\")\n",
        "            holidays_in_period = []\n",
        "            current_date = start_date\n",
        "            while current_date <= end_date:\n",
        "                if current_date in morocco_holidays:\n",
        "                    holidays_in_period.append((current_date, morocco_holidays[current_date]))\n",
        "                current_date += timedelta(days=1)\n",
        "            if holidays_in_period:\n",
        "                print(f\"  🎉 Jours fériés dans la période:\")\n",
        "                for holiday_date, holiday_name in holidays_in_period:\n",
        "                    print(f\"    - {holiday_date.strftime('%d/%m/%Y')}: {holiday_name}\")\n",
        "            else:\n",
        "                print(f\"  ⚪ Aucun jour férié dans la période\")\n",
        "        except Exception as e:\n",
        "            print(f\"  ⚠️ Erreur chargement jours fériés Maroc: {e}\")\n",
        "            morocco_holidays = {}\n",
        "        workdays = 0\n",
        "        current_date = start_date\n",
        "        print(f\"  🔍 Calcul jour par jour:\")\n",
        "        while current_date <= end_date:\n",
        "            is_weekend = current_date.weekday() >= 5\n",
        "            is_holiday = current_date in morocco_holidays\n",
        "            if not is_weekend and not is_holiday:\n",
        "                workdays += 1\n",
