        "import holidays\n",
        "import re\n",
        "\n",
        "def find_date_achevement(input_file, module_name):\n",
        "    \"\"\"Extrait la date d'achèvement pour un module donné depuis le fichier d'entrée.\"\"\"\n",
        "    print(f\"\\n🔍 === RECHERCHE DATE D'ACHÈVEMENT POUR '{module_name}' ===\")\n",
        "    try:\n",
        "        df = pd.read_excel(input_file, header=None)\n",
        "        header_row = None\n",
        "        date_achevement_col = None\n",
        "        for row_idx in range(min(10, len(df))):\n",
        "            row_values = df.iloc[row_idx].astype(str).str.lower()\n",
        "            for col_idx, value in enumerate(row_values):\n",
        "                if 'date d\\'achèvement' in value or 'date d achevement' in value or 'completion date' in value:\n",
        "                    header_row = row_idx\n",
        "                    date_achevement_col = col_idx\n",
        "                    print(f\"✅ Colonne 'Date d'achèvement' trouvée à la ligne {row_idx}, colonne {col_idx}\")\n",
        "                    break\n",
        "            if header_row is not None:\n",
        "                break\n",
        "\n",
        "        if header_row is None:\n",
        "            print(f\"❌ Colonne 'Date d'achèvement' non trouvée\")\n",
        "            return None\n",
        "\n",
        "        df = pd.read_excel(input_file, header=header_row)\n",
        "        parametrage_patterns = [\n",
        "            f\"[{module_name}] Paramétrage\",\n",
        "            f\"{module_name} Paramétrage\",\n",
        "            f\"[{module_name}]Paramétrage\",\n",
        "            f\"({module_name}) Paramétrage\",\n",
        "            f\"{module_name}] Paramétrage\",\n",
        "            f\"Paramétrage {module_name}\",\n",
        "            f\"Paramétrage [{module_name}]\"\n",
        "        ]\n",
        "        for idx, row in df.iterrows():\n",
        "            row_text = ' '.join([str(val) for val in row.values if pd.notna(val) and str(val).strip() != '']).lower()\n",
        "            if any(pattern.lower() in row_text for pattern in parametrage_patterns):\n",
        "                date_val = row.iloc[date_achevement_col]\n",
        "                if pd.notna(date_val):\n",
        "                    try:\n",
        "                        date_obj = pd.to_datetime(date_val, errors='coerce')\n",
        "                        if pd.notna(date_obj) and date_obj.year >= 2000 and date_obj.year <= 2050:\n",
        "                            formatted_date = date_obj.strftime('%d/%m/%Y')\n",
        "                            print(f\"✅ Date d'achèvement trouvée pour {module_name}: {formatted_date}\")\n",
        "                            return formatted_date\n",
        "                    except Exception as e:\n",
        "                        print(f\"⚠️ Erreur lecture date d'achèvement: {e}\")\n",
        "        print(f\"❌ Aucune date d'achèvement valide trouvée pour {module_name}\")\n",
        "        return None\n",
        "    except Exception as e:\n",
        "        print(f\"❌ Erreur lecture fichier: {e}\")\n",
        "        return None\n",
        "\n",
        "def find_date_passation(input_file, module_name):\n",
        "    \"\"\"Extrait la date de passation pour un module donné depuis le fichier d'entrée.\"\"\"\n",
        "    print(f\"\\n🔍 === RECHERCHE DATE DE PASSATION POUR '{module_name}' ===\")\n",
        "    try:\n",
        "        df = pd.read_excel(input_file, header=None)\n",
        "        header_row = None\n",
        "        date_end_col = None\n",
        "        for row_idx in range(min(10, len(df))):\n",
        "            row_values = df.iloc[row_idx].astype(str).str.lower()\n",
        "            for col_idx, value in enumerate(row_values):\n",
