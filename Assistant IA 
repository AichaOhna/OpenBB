        "                    break\n",
        "            if module:\n",
        "                temps_days = row['TempsConsacre_Days']\n",
        "                consumed_charges_anneaux[module] += temps_days\n",
        "                print(f\"  ✅ Ligne {idx} (anneaux): {temps_days}j ajoutés au module {module} (components: '{components_value}', temps consacré: '{temps_consacre_value}')\")\n",
        "            else:\n",
        "                print(f\"  ⚠️ Module non mappé pour components '{components_value}' (normalisé: '{components_normalized}') (anneaux)\")\n",
        "\n",
        "        for module in consumed_charges_anneaux:\n",
