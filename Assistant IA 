        "            'lighthouse_score': random.randint(85, 95),\n",
        "            'response_time': random.randint(200, 500)\n",
        "        }\n",
        "\n",
        "        # Ajustements basés sur les métriques réelles\n",
        "        try:\n",
        "            charge_est = float(str(metriques.get('Charge estimée (jh)', 0)).replace(',', '.'))\n",
        "            charge_cons = float(str(metriques.get('Charge consommée (jh)', 0)).replace(',', '.'))\n",
        "\n",
        "            if charge_cons > charge_est and charge_est > 0:\n",
        "                depassement = ((charge_cons - charge_est) / charge_est * 100)\n",
        "                params['charge_reduction'] = min(int(depassement * 0.8), 50)  # Réduction réaliste\n",
        "\n",
        "            retard = float(str(metriques.get('Jours de retard', 0)))\n",
        "            if retard > 0:\n",
        "                params['retard_days'] = int(retard)\n",
        "                params['critical_reduction'] = min(int(retard * 2), 40)\n",
        "                params['mvp_time'] = max(int(retard * 0.6), 5)\n",
        "\n",
        "        except:\n",
        "            pass  # Garder les valeurs par défaut si erreur\n",
        "\n",
        "        return params\n",
