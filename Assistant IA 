        "\n",
        "        progress_bar = st.progress(0)\n",
        "        total_modules = len(df)\n",
        "\n",
        "        for index, row in df.iterrows():\n",
        "            module = row['Module']\n",
        "            progress = (index + 1) / total_modules\n",
        "            progress_bar.progress(progress)\n",
        "\n",
        "            st.write(f\"Analyse intelligente du module {module}...\")\n",
        "\n",
        "            # Extraction des métriques\n",
        "            metriques = self._extract_metrics(row, module)\n",
        "\n",
        "            # Analyse des problèmes avec seuils configurables\n",
        "            problemes = self._analyze_problems_with_thresholds(metriques, module)\n",
        "\n",
        "            # Génération d'actions intelligentes\n",
        "            actions_list = self.action_generator.generate_smart_actions(module, metriques, problemes)\n",
        "\n",
        "            # Validation qualité\n",
        "            is_valid, validation_errors = self.validator.validate_actions(actions_list, module)\n",
        "\n",
        "            # Amélioration si nécessaire\n",
        "            if not is_valid:\n",
        "                st.info(f\"Amélioration de la qualité pour {module}...\")\n",
        "                actions_list = self._improve_actions_quality(module, actions_list, validation_errors)\n",
        "                is_valid, validation_errors = self.validator.validate_actions(actions_list, module)\n",
        "\n",
        "            # Stockage des résultats\n",
        "            results['modules'][module] = {\n",
        "                'metriques': metriques,\n",
        "                'problemes': problemes,\n",
        "                'actions': actions_list,\n",
        "                'validation': {\n",
        "                    'valid': is_valid,\n",
        "                    'errors': validation_errors,\n",
        "                    'method': 'Intelligent Rules Engine'\n",
        "                },\n",
        "                'analysis_confidence': self._calculate_confidence_score(metriques, problemes, actions_list)\n",
        "            }\n",
        "\n",
        "            results['recommendations_count'] += len(actions_list)\n",
        "\n",
        "        # Calcul du score qualité global\n",
        "        results['quality_score'] = self._calculate_global_quality_score(results)\n",
        "\n",
        "        # Sauvegarde dans la base de connaissances\n",
        "        self.knowledge_base.store_analysis_result(projet_nom, results['modules'], results)\n",
        "\n",
        "        progress_bar.empty()\n",
        "        return results\n",
        "\n",
        "    def _extract_metrics(self, row: pd.Series, module: str) -> Dict:\n",
        "        \"\"\"Extraction des métriques avec nettoyage intelligent\"\"\"\n",
        "        module_config = self.config_manager.get_module_config(module)\n",
        "        metriques = {'module': module}\n",
        "\n",
        "        # Métriques standard avec nettoyage\n",
        "        standard_metrics = [\n",
        "            'Charge estimée (jh)', 'Charge consommée (jh)', 'RAF théorique (jh)',\n",
        "            'Jours de retard', 'Volume bugs', 'Taux de rework', 'Respect des jalons',\n",
        "            'Productivité', 'Qualité', 'Ratio cible', 'Ratio constaté'\n",
        "        ]\n",
        "\n",
        "        for metric in standard_metrics:\n",
        "            if metric in row.index and pd.notna(row[metric]):\n",
        "                # Nettoyage et conversion intelligente\n",
        "                value = str(row[metric]).replace(',', '.').strip()\n",
        "                try:\n",
        "                    # Tentative de conversion numérique\n",
        "                    numeric_value = float(value)\n",
        "                    metriques[metric] = numeric_value\n",
        "                except ValueError:\n",
        "                    # Garder la valeur texte si pas numérique\n",
        "                    metriques[metric] = value\n",
        "\n",
        "        return metriques\n",
        "\n",
        "    def _analyze_problems_with_thresholds(self, metriques: Dict, module: str) -> List[Dict]:\n",
        "        \"\"\"Analyse intelligente des problèmes\"\"\"\n",
        "        module_config = self.config_manager.get_module_config(module)\n",
        "        seuils = module_config.get('seuils', {})\n",
        "\n",
        "        problemes = []\n",
        "\n",
        "        # Analyse charge avec intelligence adaptative\n",
        "        try:\n",
        "            charge_est = float(metriques.get('Charge estimée (jh)', 0))\n",
        "            charge_cons = float(metriques.get('Charge consommée (jh)', 0))\n",
        "\n",
        "            if charge_cons > charge_est and charge_est > 0:\n",
        "                depassement = ((charge_cons - charge_est) / charge_est * 100)\n",
        "\n",
        "                # Seuils adaptatifs selon criticité du module\n",
        "                criticite = module_config.get('criticite', 'MOYENNE')\n",
        "                if criticite == 'CRITIQUE':\n",
        "                    seuil_critique = seuils.get('charge_depassement_critique', 15)\n",
        "                    seuil_majeur = seuils.get('charge_depassement_majeur', 5)\n",
        "                else:\n",
        "                    seuil_critique = seuils.get('charge_depassement_critique', 25)\n",
        "                    seuil_majeur = seuils.get('charge_depassement_majeur', 10)\n",
        "\n",
        "                if depassement > seuil_critique:\n",
        "                    gravite = 'CRITIQUE'\n",
        "                elif depassement > seuil_majeur:\n",
        "                    gravite = 'MAJEUR'\n",
        "                else:\n",
        "                    gravite = 'MINEUR'\n",
        "\n",
        "                if gravite in ['CRITIQUE', 'MAJEUR']:\n",
        "                    problemes.append({\n",
        "                        'type': 'CHARGE_DEPASSEMENT',\n",
        "                        'gravite': gravite,\n",
        "                        'description': f\"Dépassement charge de {depassement:.1f}% (seuil: {seuil_critique}%)\",\n",
        "                        'valeur': depassement,\n",
        "                        'impact_estimé': 'ÉLEVÉ' if depassement > 30 else 'MODÉRÉ',\n",
        "                        'priorité': 1 if gravite == 'CRITIQUE' else 2\n",
        "                    })\n",
        "        except (ValueError, TypeError):\n",
        "            pass\n",
        "\n",
        "        # Analyse retards avec contexte intelligent\n",
        "        try:\n",
        "            retard = float(metriques.get('Jours de retard', 0))\n",
        "            if retard > 0:\n",
        "                # Seuils adaptatifs selon criticité\n",
        "                criticite = module_config.get('criticite', 'MOYENNE')\n",
        "                if criticite == 'CRITIQUE':\n",
        "                    seuil_critique = seuils.get('retard_critique', 20)\n",
        "                    seuil_majeur = seuils.get('retard_majeur', 5)\n",
        "                else:\n",
        "                    seuil_critique = seuils.get('retard_critique', 30)\n",
        "                    seuil_majeur = seuils.get('retard_majeur', 10)\n",
        "\n",
        "                if retard > seuil_critique:\n",
        "                    gravite = 'CRITIQUE'\n",
        "                elif retard > seuil_majeur:\n",
        "                    gravite = 'MAJEUR'\n",
        "                else:\n",
        "                    gravite = 'MINEUR'\n",
        "\n",
        "                if gravite in ['CRITIQUE', 'MAJEUR']:\n",
        "                    problemes.append({\n",
        "                        'type': 'RETARD',\n",
        "                        'gravite': gravite,\n",
        "                        'description': f\"Retard de {retard} jours (seuil: {seuil_critique}j)\",\n",
        "                        'valeur': retard,\n",
        "                        'impact_estimé': 'ÉLEVÉ' if retard > 20 else 'MODÉRÉ',\n",
        "                        'priorité': 1 if gravite == 'CRITIQUE' else 2\n",
        "                    })\n",
        "        except (ValueError, TypeError):\n",
        "            pass\n",
        "\n",
        "        # Analyse bugs avec intelligence contextuelle\n",
        "        try:\n",
        "            bugs = float(metriques.get('Volume bugs', 0))\n",
        "            if bugs > 0:\n",
        "                criticite = module_config.get('criticite', 'MOYENNE')\n",
        "                if criticite == 'CRITIQUE':\n",
        "                    seuil_critique = seuils.get('bugs_critique', 5)\n",
        "                    seuil_majeur = seuils.get('bugs_majeur', 1)\n",
        "                else:\n",
        "                    seuil_critique = seuils.get('bugs_critique', 20)\n",
        "                    seuil_majeur = seuils.get('bugs_majeur', 10)\n",
        "\n",
        "                if bugs > seuil_critique:\n",
        "                    gravite = 'CRITIQUE'\n",
        "                elif bugs > seuil_majeur:\n",
        "                    gravite = 'MAJEUR'\n",
        "                else:\n",
        "                    gravite = 'MINEUR'\n",
        "\n",
        "                if gravite in ['CRITIQUE', 'MAJEUR']:\n",
        "                    problemes.append({\n",
        "                        'type': 'BUGS_ELEVES',\n",
        "                        'gravite': gravite,\n",
        "                        'description': f\"{bugs} bugs détectés (seuil: {seuil_critique})\",\n",
        "                        'valeur': bugs,\n",
        "                        'impact_estimé': 'CRITIQUE' if bugs > seuil_critique * 2 else 'ÉLEVÉ',\n",
        "                        'priorité': 1 if gravite == 'CRITIQUE' else 2\n",
        "                    })\n",
        "        except (ValueError, TypeError):\n",
        "            pass\n",
        "\n",
        "        # Analyse qualité générale\n",
        "        try:\n",
        "            qualite = float(metriques.get('Qualité', 100))\n",
        "            if qualite < 80:\n",
        "                gravite = 'CRITIQUE' if qualite < 60 else 'MAJEUR'\n",
        "                problemes.append({\n",
        "                    'type': 'QUALITE_FAIBLE',\n",
        "                    'gravite': gravite,\n",
        "                    'description': f\"Qualité faible: {qualite}% (cible: >80%)\",\n",
        "                    'valeur': qualite,\n",
        "                    'impact_estimé': 'ÉLEVÉ',\n",
        "                    'priorité': 1 if gravite == 'CRITIQUE' else 2\n",
        "                })\n",
        "        except (ValueError, TypeError):\n",
        "            pass\n",
        "\n",
        "        # Tri des problèmes par priorité\n",
        "        problemes.sort(key=lambda x: x.get('priorité', 3))\n",
        "\n",
        "        return problemes\n",
        "\n",
        "    def _improve_actions_quality(self, module: str, actions: List[str], errors: List[str]) -> List[str]:\n",
        "        \"\"\"Améliore la qualité des actions basé sur les erreurs détectées\"\"\"\n",
        "\n",
        "        improved_actions = []\n",
        "        module_config = self.config_manager.get_module_config(module)\n",
        "        expertises = module_config.get('expertises', ['Expert généraliste'])\n",
        "\n",
        "        for action in actions:\n",
        "            improved_action = action\n",
        "\n",
        "            # Corriger les actions trop courtes\n",
        "            if len(action) < 50:\n",
        "                improved_action = f\"Amélioration complète {module.lower()} - {action} → Objectif: Optimisation performance globale → Délai: 7j → Ressources: {expertises[0]}\"\n",
        "\n",
        "            # Ajouter les éléments manquants\n",
        "            if 'délai' not in improved_action.lower():\n",
        "                improved_action += f\" → Délai: {random.randint(3, 8)}j\"\n",
        "\n",
        "            if 'objectif' not in improved_action.lower():\n",
        "                improved_action += f\" → Objectif: Amélioration mesurable performance\"\n",
        "\n",
        "            if 'ressources' not in improved_action.lower():\n",
        "                improved_action += f\" → Ressources: {random.choice(expertises)}\"\n",
        "\n",
        "            improved_actions.append(improved_action)\n",
        "\n",
        "        # Ajouter des actions supplémentaires si pas assez\n",
        "        while len(improved_actions) < 3:\n",
        "            fallback_action = f\"Action corrective {module} spécialisée → Objectif: Résolution problèmes identifiés → Délai: {random.randint(5, 10)}j → Ressources: {random.choice(expertises)} + Support technique\"\n",
        "            improved_actions.append(fallback_action)\n",
        "\n",
        "        return improved_actions[:4]  # Maximum 4 actions\n",
        "\n",
        "    def _calculate_confidence_score(self, metriques: Dict, problemes: List[Dict], actions: List[str]) -> float:\n",
        "        \"\"\"Calcule un score de confiance de l'analyse\"\"\"\n",
        "\n",
        "        confidence_factors = {\n",
        "            'data_quality': 0.0,\n",
        "            'problem_identification': 0.0,\n",
        "            'action_relevance': 0.0\n",
        "        }\n",
        "\n",
        "        # Qualité des données\n",
        "        numeric_metrics = sum(1 for v in metriques.values() if isinstance(v, (int, float)))\n",
        "        total_metrics = len(metriques) - 1  # Exclure 'module'\n",
        "        if total_metrics > 0:\n",
        "            confidence_factors['data_quality'] = numeric_metrics / total_metrics\n",
        "\n",
        "        # Identification des problèmes\n",
        "        if len(problemes) > 0:\n",
        "            critical_problems = sum(1 for p in problemes if p['gravite'] == 'CRITIQUE')\n",
        "            confidence_factors['problem_identification'] = min(1.0, (len(problemes) + critical_problems) / 5)\n",
        "        else:\n",
        "            confidence_factors['problem_identification'] = 0.5  # Score neutre si pas de problèmes\n",
        "\n",
        "        # Pertinence des actions\n",
        "        valid_actions = sum(1 for action in actions if len(action) > 50 and '→' in action)\n",
        "        if len(actions) > 0:\n",
        "            confidence_factors['action_relevance'] = valid_actions / len(actions)\n",
        "\n",
        "        # Score global pondéré\n",
        "        return (confidence_factors['data_quality'] * 0.3 +\n",
        "                confidence_factors['problem_identification'] * 0.4 +\n",
        "                confidence_factors['action_relevance'] * 0.3)\n",
        "\n",
        "    def _calculate_global_quality_score(self, results: Dict) -> float:\n",
        "        \"\"\"Calcule un score de qualité global pour l'analyse\"\"\"\n",
        "        total_modules = len(results['modules'])\n",
        "        if total_modules == 0:\n",
        "            return 0.0\n",
        "\n",
        "        # Facteurs de qualité\n",
        "        valid_modules = sum(1 for module_data in results['modules'].values()\n",
        "                          if module_data['validation']['valid'])\n",
        "\n",
        "        total_confidence = sum(module_data.get('analysis_confidence', 0.5)\n",
        "                             for module_data in results['modules'].values())\n",
        "\n",
        "        avg_confidence = total_confidence / total_modules if total_modules > 0 else 0.0\n",
        "        validation_score = valid_modules / total_modules\n",
        "\n",
        "        # Actions par module (bonus si > 3 actions par module en moyenne)\n",
        "        total_actions = sum(len(module_data['actions'])\n",
        "                           for module_data in results['modules'].values())\n",
        "        avg_actions_per_module = total_actions / total_modules if total_modules > 0 else 0\n",
        "        action_bonus = min(0.2, (avg_actions_per_module - 3) * 0.05)\n",
        "\n",
        "        # Score composite\n",
        "        global_score = (validation_score * 0.4 + avg_confidence * 0.5 + action_bonus)\n",
        "        return min(1.0, global_score)\n",
        "\n",
        "    def save_to_excel(self, output_path: str, results: Dict) -> bool:\n",
        "        \"\"\"Sauvegarde les résultats dans Excel avec formatage avancé\"\"\"\n",
        "        try:\n",
        "            wb = openpyxl.load_workbook(output_path)\n",
        "            ws = wb.active\n",
        "\n",
        "            # Configuration depuis le gestionnaire\n",
        "            colonne_actions = self.config_manager.config['output']['excel_column']\n",
        "\n",
        "            # Mapping des modules aux lignes\n",
        "            modules_lignes = {'GA': 3, 'GTA': 4, 'PAIE': 5, 'PORTAIL': 6}\n",
        "\n",
        "            for module, ligne in modules_lignes.items():\n",
        "                if module in results['modules']:\n",
        "                    module_data = results['modules'][module]\n",
        "                    actions_list = module_data['actions']\n",
        "                    confidence = module_data.get('analysis_confidence', 0.5)\n",
        "\n",
        "                    # En-tête avec métadonnées\n",
        "                    header = f\"ANALYSE INTELLIGENTE {module} - Score: {results['quality_score']:.1%}\"\n",
        "                    separator = \"=\" * len(header)\n",
        "\n",
        "                    # Actions formatées avec numérotation\n",
        "                    actions_text = []\n",
        "                    for i, action in enumerate(actions_list, 1):\n",
        "                        action_clean = action.replace(f\"Action {i}:\", \"\").strip()\n",
        "                        actions_text.append(f\"{i}. {action_clean}\")\n",
        "\n",
        "                    # Problèmes identifiés\n",
        "                    problems_section = \"\"\n",
        "                    if module_data['problemes']:\n",
        "                        problems_section = \"\\nPROBLÈMES IDENTIFIÉS:\\n\"\n",
        "                        for prob in module_data['problemes'][:3]:  # Max 3 problèmes affichés\n",
        "                            problems_section += f\"• {prob['gravite']}: {prob['description']}\\n\"\n",
        "\n",
        "                    # Métadonnées techniques\n",
        "                    metadata = [\n",
        "                        f\"✓ Moteur de règles intelligentes\",\n",
        "                        f\"📊 Confiance analyse: {confidence:.1%}\",\n",
        "                        f\"⚡ {len(actions_list)} actions générées\",\n",
        "                        f\"🎯 Méthode: {module_data['validation']['method']}\"\n",
        "                    ]\n",
        "\n",
        "                    # Indicateur de qualité\n",
        "                    quality_indicator = \"🟢\" if module_data['validation']['valid'] else \"🟡\"\n",
        "\n",
        "                    # Texte final assemblé\n",
        "                    final_text = f\"{quality_indicator} {header}\\n{separator}\\n\"\n",
        "                    final_text += \"\\n\".join(actions_text)\n",
        "                    final_text += problems_section\n",
        "                    final_text += f\"\\n{separator}\\nMÉTADONNÉES:\\n\" + \"\\n\".join(metadata)\n",
        "                    final_text += f\"\\n\\nGénéré le: {datetime.now().strftime('%d/%m/%Y %H:%M')}\"\n",
        "\n",
        "                    # Écriture dans Excel\n",
        "                    cell = ws.cell(row=ligne, column=colonne_actions)\n",
        "                    cell.value = final_text\n",
        "\n",
        "                    # Formatage selon qualité\n",
        "                    cell.alignment = Alignment(wrap_text=True, vertical='top')\n",
        "\n",
        "                    # Couleurs selon performance\n",
        "                    if confidence > 0.8:\n",
        "                        cell.fill = PatternFill(start_color=\"D4F6D4\", end_color=\"D4F6D4\", fill_type=\"solid\")  # Vert clair\n",
        "                    elif confidence > 0.6:\n",
        "                        cell.fill = PatternFill(start_color=\"FFF8DC\", end_color=\"FFF8DC\", fill_type=\"solid\")  # Beige\n",
        "                    else:\n",
        "                        cell.fill = PatternFill(start_color=\"FFE4E1\", end_color=\"FFE4E1\", fill_type=\"solid\")  # Rose clair\n",
        "\n",
        "                    # Ajustements de taille\n",
        "                    ws.row_dimensions[ligne].height = 180\n",
        "                    ws.column_dimensions['G'].width = 95\n",
        "\n",
        "            # Feuille de synthèse\n",
        "            if \"Synthèse_Analysis\" not in wb.sheetnames:\n",
        "                synthesis_sheet = wb.create_sheet(\"Synthèse_Analysis\")\n",
        "\n",
        "                # En-tête de synthèse\n",
        "                synthesis_sheet['A1'] = \"RAPPORT SYNTHÈSE - ANALYSE INDUSTRIELLE GRATUITE\"\n",
        "                synthesis_sheet['A1'].font = Font(bold=True, size=14)\n",
        "\n",
        "                synthesis_sheet['A3'] = f\"Projet analysé: {results['projet']}\"\n",
        "                synthesis_sheet['A4'] = f\"Date d'analyse: {results['timestamp']}\"\n",
        "                synthesis_sheet['A5'] = f\"Méthode: {results['analysis_method']}\"\n",
        "                synthesis_sheet['A6'] = f\"Score qualité global: {results['quality_score']:.1%}\"\n",
        "                synthesis_sheet['A7'] = f\"Total recommandations: {results['recommendations_count']}\"\n",
        "\n",
        "                # Détails par module\n",
        "                row_start = 9\n",
        "                synthesis_sheet[f'A{row_start}'] = \"DÉTAILS PAR MODULE:\"\n",
        "                synthesis_sheet[f'A{row_start}'].font = Font(bold=True)\n",
        "\n",
        "                row = row_start + 1\n",
        "                for module, data in results['modules'].items():\n",
        "                    confidence = data.get('analysis_confidence', 0.5)\n",
        "                    problems_count = len(data['problemes'])\n",
        "                    actions_count = len(data['actions'])\n",
        "\n",
        "                    synthesis_sheet[f'A{row}'] = f\"{module}:\"\n",
        "                    synthesis_sheet[f'B{row}'] = f\"Confiance: {confidence:.1%}\"\n",
        "                    synthesis_sheet[f'C{row}'] = f\"Problèmes: {problems_count}\"\n",
        "                    synthesis_sheet[f'D{row}'] = f\"Actions: {actions_count}\"\n",
        "                    synthesis_sheet[f'E{row}'] = \"✓ Validé\" if data['validation']['valid'] else \"⚠ Partiel\"\n",
        "                    row += 1\n",
        "\n",
        "                # Recommandations générales\n",
        "                recommendations_start = row + 2\n",
        "                synthesis_sheet[f'A{recommendations_start}'] = \"RECOMMANDATIONS GÉNÉRALES:\"\n",
        "                synthesis_sheet[f'A{recommendations_start}'].font = Font(bold=True)\n",
        "\n",
        "                general_recommendations = [\n",
        "                    \"• Prioriser les actions sur les modules à criticité élevée\",\n",
        "                    \"• Mettre en place un suivi hebdomadaire des indicateurs\",\n",
        "                    \"• Former les équipes sur les bonnes pratiques identifiées\",\n",
        "                    f\"• Focus prioritaire: {max(results['modules'].items(), key=lambda x: len(x[1]['problemes']))[0] if results['modules'] else 'N/A'}\"\n",
        "                ]\n",
        "\n",
        "                for i, rec in enumerate(general_recommendations):\n",
        "                    synthesis_sheet[f'A{recommendations_start + 1 + i}'] = rec\n",
        "\n",
        "            wb.save(output_path)\n",
        "            return True\n",
        "\n",
        "        except Exception as e:\n",
        "            logger.error(f\"Erreur sauvegarde Excel: {e}\")\n",
        "            return False\n",
        "\n",
