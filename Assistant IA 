        "\n",
        "        print(f\"✅ {len(df_filtered)} enregistrements après filtrage par type 'Anomalie' (anneaux)\")\n",
        "        df_filtered['TempsConsacre_Days'] = df_filtered[temps_consacre_col].apply(parse_temps_consacre)\n",
        "\n",
        "        for idx, row in df_filtered.iterrows():\n",
