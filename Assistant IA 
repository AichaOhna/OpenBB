        "            'ga ': 'GA', 'gta ': 'GTA', 'paie ': 'PAIE', 'portail ': 'PORTAIL',\n",
        "            'PAIE': 'PAIE', 'Paie': 'PAIE', 'PORTAIL': 'PORTAIL', 'Portail': 'PORTAIL',\n",
